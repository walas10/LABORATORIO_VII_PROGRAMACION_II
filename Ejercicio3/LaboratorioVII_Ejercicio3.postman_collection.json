                                     "url":  "{{baseUrl}}/empleados"
                                 },
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\"HTTP 200\", function () {     pm.response.to.have.status(200); });"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ],
                     "response":  [

