                 {
                     "name":  "04 GET consultar ID existente",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "type":  "text",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "X-API-KEY",
                                                        "type":  "text",
                                                        "value":  "{{apiKey}}"
                                                    }
                                                ],
                                     "auth":  {
                                                  "type":  "noauth"
                                              },
                                     "url":  "{{baseUrl}}/empleados/{{id}}"
                                 },
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\"HTTP 200\", function () {     pm.response.to.have.status(200); });",
                                                                   "if (pm.response.code === 200) {",
                                                                   "    pm.test(\"ID consultado coincide con el creado\", function () {",
                                                                   "        pm.expect(String(pm.response.json().id)).to.eql(String(pm.variables.get(\"id\")));",
                                                                   "    });",
                                                                   "}"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ],
                     "response":  [

                                  ]
